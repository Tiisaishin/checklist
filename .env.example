# ===== 必填 =====
# 对外访问地址。使用 https:// 时 Telegram 自动启用 Webhook，否则使用 telegram 容器轮询
APP_URL=http://localhost:8080
# 加密密钥（openssl rand -base64 32）。留空会自动生成并保存在 runtime 卷中，请务必备份
APP_KEY=

# 首次启动自动创建的超级管理员
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ===== 数据库 =====
DB_NAME=checklist
DB_USER=checklist
DB_PASS=checklist
DB_ROOT_PASS=change-me-root

# ===== 其他 =====
APP_PORT=8080
APP_DEBUG=false
DEFAULT_LANG=zh-cn
DEFAULT_TIMEZONE=Asia/Shanghai
